<Page x:Class="MusicSchoolWpf.AdminSongsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AdminSongsPage"
      Background="#080808">

    <Grid Background="#080808" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- כותרת -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="חזרה"
                    Width="90"
                    Height="34"
                    Background="#222"
                    Foreground="White"
                    BorderThickness="0"
                    Click="BtnBack_Click"/>

            <TextBlock Grid.Column="1"
                       Text="ניהול שירים במערכת"
                       Foreground="#CC2200"
                       FontSize="25"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- צד שמאל: שירים קיימים + חיפוש API -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#111"
                        BorderBrush="#333"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel FlowDirection="RightToLeft">
                        <TextBlock Text="חיפוש מידע חיצוני מ-iTunes"
                                   Foreground="#CC2200"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="כתוב שם שיר או אמן. המערכת תביא שם שיר, אמן, אלבום, ז'אנר ותמונה."
                                   Foreground="#999"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtApiSearch"
                                     Grid.Column="0"
                                     Height="34"
                                     Background="#222"
                                     Foreground="White"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                    Content="חפש"
                                    Height="34"
                                    Background="#CC2200"
                                    Foreground="White"
                                    Click="BtnSearchApi_Click"/>
                        </Grid>

                        <TextBlock x:Name="lblApiStatus"
                                   Text=""
                                   Foreground="#888"
                                   FontSize="11"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox x:Name="lstApiResults"
                         Grid.Row="1"
                         Background="#111"
                         BorderBrush="#333"
                         Foreground="White"
                         SelectionChanged="LstApiResults_SelectionChanged"
                         Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="2">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CollectionName}"
                                               Foreground="#888"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding PrimaryGenreName}"
                                               Foreground="#CC2200"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="שירים קיימים במערכת"
                           Foreground="#CC2200"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,8"
                           FlowDirection="RightToLeft"/>

                <ListBox x:Name="lstExistingSongs"
                         Grid.Row="3"
                         Background="#111"
                         BorderBrush="#333"
                         Foreground="White"
                         SelectionChanged="LstExistingSongs_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="2">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Artistid.Name}"
                                               Foreground="#888"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- צד ימין: טופס -->
            <Border Grid.Column="1"
                    Background="#111"
                    BorderBrush="#CC2200"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="20">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel FlowDirection="RightToLeft">

                        <TextBlock Text="הוספת / עריכת שיר"
                                   Foreground="#CC2200"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="שם השיר:"
                                   Foreground="White"
                                   Margin="0,4"/>
                        <TextBox x:Name="txtSongName"
                                 Background="#222"
                                 Foreground="White"
                                 Height="34"
                                 VerticalContentAlignment="Center"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="אמן:"
                                           Foreground="White"
                                           Margin="0,4"/>
                                <ComboBox x:Name="cmbArtist"
                                          Background="#222"
                                          Foreground="Black"
                                          Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="סגנון:"
                                           Foreground="White"
                                           Margin="0,4"/>
                                <ComboBox x:Name="cmbGenre"
                                          Background="#222"
                                          Foreground="Black"
                                          Height="34"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="שפה:"
                                           Foreground="White"
                                           Margin="0,4"/>
                                <ComboBox x:Name="cmbLanguage"
                                          Background="#222"
                                          Foreground="Black"
                                          Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="דרגת קושי:"
                                           Foreground="White"
                                           Margin="0,4"/>
                                <materialDesign:RatingBar x:Name="songRating"
                                                          Value="3"
                                                          Foreground="#CC2200"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="תמונת שיר:"
                                   Foreground="White"
                                   Margin="0,18,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="בחר תמונה מהמחשב"
                                    Background="#333"
                                    Foreground="White"
                                    Click="BtnUploadPic_Click"/>

                            <TextBlock x:Name="lblPicStatus"
                                       Grid.Column="1"
                                       Text="לא נבחרה תמונה"
                                       Foreground="#888"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>

                        <TextBlock Text="מילים ואקורדים:"
                                   Foreground="White"
                                   Margin="0,20,0,5"/>

                        <TextBlock Text="מומלץ לכתוב בפורמט: [C]מילים של השורה  או  [Am]עוד שורה"
                                   Foreground="#888"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txtLyricsAndChords"
                                 Background="#222"
                                 Foreground="White"
                                 Height="170"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="ייבוא מילים מקובץ TXT"
                                    Background="#333"
                                    Foreground="White"
                                    Height="36"
                                    Margin="0,0,6,0"
                                    Click="BtnImportTxt_Click"/>

                            <Button Grid.Column="1"
                                    Content="נקה טופס"
                                    Background="#333"
                                    Foreground="White"
                                    Height="36"
                                    Margin="6,0,0,0"
                                    Click="BtnClear_Click"/>
                        </Grid>

                        <Button x:Name="btnSave"
                                Content="שמור שיר במערכת"
                                Background="#CC2200"
                                Foreground="White"
                                Height="42"
                                Margin="0,24,0,8"
                                FontWeight="Bold"
                                Click="BtnSaveSong_Click"/>

                        <Button x:Name="btnDelete"
                                Content="מחק שיר נבחר"
                                Background="#222"
                                Foreground="#FF7777"
                                Height="36"
                                BorderBrush="#661111"
                                BorderThickness="1"
                                Click="BtnDeleteSong_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>