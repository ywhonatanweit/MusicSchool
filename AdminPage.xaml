<Page x:Class="MusicSchoolWpf.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AdminPage" Background="#0D0D0D">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <Button Content="חזרה למסך הבית" Background="#222" Foreground="White" BorderThickness="0" Click="BtnBack_Click" Margin="0,0,20,0"/>
            <TextBlock x:Name="lblPageTitle" Text="ניהול שיר במערכת" Foreground="#CC2200" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#161616" CornerRadius="15" BorderBrush="#CC2200" BorderThickness="1.5" Padding="25" MaxWidth="600" HorizontalAlignment="Center">
                <StackPanel FlowDirection="RightToLeft">

                    <TextBlock Text="שם השיר:" Foreground="#F5F5F5" Margin="0,5"/>
                    <TextBox x:Name="txtSongName" Background="#222" Foreground="White" Height="35" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="אמן:" Foreground="#F5F5F5" Margin="0,5"/>
                            <ComboBox x:Name="cmbArtist" Background="#222" Foreground="Black" Height="40"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="סגנון (ג'אנר):" Foreground="#F5F5F5" Margin="0,5"/>
                            <ComboBox x:Name="cmbGenre" Background="#222" Foreground="Black" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="דרגת קושי:" Foreground="#F5F5F5" Margin="0,15,0,5"/>
                    <materialDesign:RatingBar x:Name="songRating" Value="3" Foreground="#CC2200"/>

                    <TextBlock Text="תמונת שיר:" Foreground="#F5F5F5" Margin="0,15,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="בחר קובץ" Background="#333" Foreground="White" Click="BtnUploadPic_Click"/>
                        <TextBlock Grid.Column="1" x:Name="lblPicStatus" Text="לא נבחרה תמונה חדשה" Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </Grid>

                    <TextBlock Text="מילים ואקורדים (פורמט חכם):" Foreground="#F5F5F5" Margin="0,20,0,5"/>
                    <TextBlock Text="לדוגמה: פעם אחת[C] הייתי צעיר[Am]" Foreground="Gray" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLyricsAndChords" Background="#222" Foreground="White" Height="150" AcceptsReturn="True" TextWrapping="Wrap" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <Button x:Name="btnSave" Content="שמור שינויים במערכת" Background="#CC2200" Foreground="White" Height="45" Margin="0,30,0,10" FontWeight="Bold" Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>