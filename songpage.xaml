<Page x:Class="MusicSchoolWpf.songpage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicSchoolWpf"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="songpage" Background="Black">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- כותרת וחיפוש -->
        <StackPanel x:Name="SearchHeader" Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Stretch" Margin="20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SEARCH" FontSize="40" Foreground="DarkRed" FontWeight="Bold"/>
                <TextBox x:Name="txtSearch" Width="250" Height="35" FontSize="18" 
                         Background="#222" Foreground="White" CaretBrush="Black"
                         Margin="0,5,0,0" VerticalContentAlignment="Center"
                         TextChanged="txtSearch_TextChanged" />
            </StackPanel>
            <TextBlock Text="songs" FontSize="80" Foreground="DarkRed" Margin="250,0,0,0" HorizontalAlignment="Right"/>
        </StackPanel>

        <!--  מיון וכפתור סינון -->
        <Grid x:Name="SortFilterRow" Grid.Row="1" Margin="20,0">
            <ComboBox x:Name="cmbSort" Grid.Row="1" HorizontalAlignment="Left" SelectedIndex="0" FontSize="18" 
          Width="180" Height="40" Background="Black" Foreground="DarkRed" BorderBrush="DarkRed" 
          SelectionChanged="cmbSort_SelectionChanged">
                <ComboBoxItem Content="מיין לפי" />
                <ComboBoxItem Content="(א-ב (שם שיר"/>
                <ComboBoxItem Content="קל לקשה"/>
                <ComboBoxItem Content="קשה לקל"/>
            </ComboBox>

            <Button x:Name="btnOpenFilter" Content="סנן לפי" HorizontalAlignment="Right" 
                    Background="DarkRed" BorderBrush="Transparent" Click="btnOpenFilter_Click"/>
        </Grid>

        <!-- רשימת השירים -->
        <ScrollViewer Grid.Row="2" Margin="10,10,10,10">
            <StackPanel x:Name="sp"/>
        </ScrollViewer>

        <!-- חלונית סינון (Side Panel) - מוסתרת כברירת מחדל -->
        <Grid x:Name="filterPanel" Grid.RowSpan="3" HorizontalAlignment="Right" Width="250" Background="#1A1A1A" Visibility="Collapsed">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="15" Direction="180" ShadowDepth="5"/>
            </Grid.Effect>

            <StackPanel Margin="15">
                <Button Content="X" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" 
                        Foreground="White" FontSize="20" Click="btnCloseFilter_Click"/>

                <TextBlock Text="סינון שירים" Foreground="DarkRed" FontSize="24" FontWeight="Bold" Margin="0,20,0,20" HorizontalAlignment="Right"/>

                <TextBlock Text="סגנון:" Foreground="White" HorizontalAlignment="Right"/>
                <ComboBox x:Name="cmbGenre" Margin="0,5,0,15" FlowDirection="RightToLeft"/>

                <TextBlock Text="שפה:" Foreground="White" HorizontalAlignment="Right"/>
                <ComboBox x:Name="cmbLanguage" Margin="0,5,0,15" FlowDirection="RightToLeft"/>

                <TextBlock Text="דרגת קושי:" Foreground="White" HorizontalAlignment="Right"/>
                <ComboBox x:Name="cmbDifficulty" Margin="0,5,0,15" FlowDirection="RightToLeft">
                    <!--<ComboBoxItem Content="הכל"/>-->
                    
                    <!--<ComboBoxItem Content="מתחילים"/>
                    <ComboBoxItem Content="קל"/>
                    <ComboBoxItem Content="בינוני"/>
                    <ComboBoxItem Content="קשה"/>
                    <ComboBoxItem Content="בוס"/>-->
                </ComboBox>

                <Button Content="סנן" Background="DarkRed" Margin="0,30,0,0" Click="btnApplyFilter_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>