<UserControl x:Class="MusicSchoolWpf.ChordCardUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="220" Margin="10">
    <Border Background="#222" CornerRadius="10" BorderBrush="DarkRed" BorderThickness="1">
        <StackPanel>
            <Image x:Name="imgChord" Height="120" Margin="5" Stretch="Uniform"/>
            <TextBlock x:Name="lblChordName" Text="Am" Foreground="White" 
                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="lblDifficulty" Text="Difficulty: 1" Foreground="Gray" 
                       FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>