<Page x:Class="MusicSchoolWpf.ChordTrainerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="ChordTrainerPage"
      Background="#080808">

    <Grid Margin="24" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="תרגול אקורדים רנדומלי"
                       Foreground="#CC2200"
                       FontSize="30"
                       FontWeight="Black"/>

            <TextBlock Text="בחר קצב, כמה פעימות לכל אקורד, והמערכת תחליף אקורדים בצורה אקראית עם צליל מטרונום."
                       Foreground="#888"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#111"
                BorderBrush="#222"
                BorderThickness="1"
                CornerRadius="24"
                Padding="28">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="txtChordName"
                               Text="לחץ Start"
                               Foreground="White"
                               FontSize="82"
                               FontWeight="Black"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="txtBeatInfo"
                               Text=""
                               Foreground="#777"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="260"
                        Height="260"
                        CornerRadius="18"
                        Background="#1A1A1A"
                        BorderBrush="#CC2200"
                        BorderThickness="1.4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Image x:Name="imgChord"
                           Stretch="Uniform"
                           Margin="14"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#111"
                BorderBrush="#222"
                BorderThickness="1"
                CornerRadius="18"
                Padding="18"
                Margin="0,18,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="BPM"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Slider x:Name="bpmSlider"
                                Minimum="40"
                                Maximum="220"
                                Value="80"
                                Width="250"
                                ValueChanged="BpmSlider_ValueChanged"/>

                        <TextBox x:Name="txtBpm"
                                 Text="80"
                                 Width="60"
                                 Height="30"
                                 Margin="10,0,0,0"
                                 TextAlignment="Center"
                                 Background="#222"
                                 Foreground="White"
                                 LostFocus="TxtBpm_LostFocus"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="כמה פעימות לכל אקורד"
                               Foreground="White"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Slider x:Name="beatsSlider"
                                Minimum="1"
                                Maximum="8"
                                Value="4"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Width="250"
                                ValueChanged="BeatsSlider_ValueChanged"/>

                        <TextBlock x:Name="txtBeatsPerChord"
                                   Text="4"
                                   Foreground="#CC2200"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Width="40"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                    <Button x:Name="btnNext"
                            Content="אקורד הבא"
                            Width="110"
                            Height="40"
                            Background="#333"
                            Foreground="White"
                            Margin="0,0,8,0"
                            Click="BtnNext_Click"/>

                    <Button x:Name="btnStartStop"
                            Content="Start"
                            Width="110"
                            Height="40"
                            Background="#CC2200"
                            Foreground="White"
                            FontWeight="Bold"
                            Click="BtnStartStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>