<Page x:Class="MusicSchoolWpf.chordlab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="chordlab" Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- כותרת וחיפוש -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CHORD" FontSize="40" Foreground="DarkRed" FontWeight="Bold"/>
                <TextBox x:Name="txtSearch" Width="250" Height="35" Background="#222" Foreground="White"
                         TextChanged="txtSearch_TextChanged" VerticalContentAlignment="Center"/>
            </StackPanel>
            <!--<TextBlock Text="lab" FontSize="80" Foreground="DarkRed" Margin="280,0,0,0"/>-->
        </StackPanel>

        <!-- כלים -->
        <Grid Grid.Row="1" Margin="20,0">
            <ComboBox x:Name="cmbSort" HorizontalAlignment="Left" Width="180" Height="40" 
                      Background="Black" Foreground="DarkRed" BorderBrush="DarkRed"
                      SelectionChanged="cmbSort_SelectionChanged">
                <ComboBoxItem Content="מיין לפי" IsSelected="True"/>
                <ComboBoxItem Content="שם"/>
                <ComboBoxItem Content="קל לקשה"/>
                <ComboBoxItem Content="קשה לקל"/>
            </ComboBox>
            <Button Content="סנן לפי קושי" HorizontalAlignment="Right" Background="DarkRed" Click="btnOpenFilter_Click"/>
        </Grid>

        <!-- תצוגת אקורדים - כאן נשתמש ב-WrapPanel כדי שהם יוצגו בטורים ושורות -->
        <ScrollViewer Grid.Row="2" Margin="10">
            <WrapPanel x:Name="wpChords" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- פאנל סינון צדדי -->
        <Grid x:Name="filterPanel" Grid.RowSpan="3" HorizontalAlignment="Right" Width="250" Background="#1A1A1A" Visibility="Collapsed">
            <StackPanel Margin="15">
                <Button Content="X" HorizontalAlignment="Left" Background="Transparent" Foreground="White" Click="btnCloseFilter_Click"/>
                <TextBlock Text="סינון אקורדים" Foreground="DarkRed" FontSize="24" Margin="0,20" HorizontalAlignment="Right"/>
                <TextBlock Text="דרגת קושי:" Foreground="White" HorizontalAlignment="Right"/>
                <ComboBox x:Name="cmbDifficulty" Margin="0,5" FlowDirection="RightToLeft"/>
                <Button Content="סנן" Background="DarkRed" Margin="0,30" Click="btnApplyFilter_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>