<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="pages\" />
  </ItemGroup>
	<ItemGroup>
		<Content Include="IMAGES\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="Model">
	    <HintPath>..\MusicSchool-project\Service\bin\Debug\net8.0\Model.dll</HintPath>
	  </Reference>
	  <Reference Include="Service">
	    <HintPath>..\MusicSchool-project\Service\bin\Debug\net8.0\Service.dll</HintPath>
	  </Reference>
	  <Reference Include="ViewModel">
	    <HintPath>..\MusicSchool-project\Service\bin\Debug\net8.0\ViewModel.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>
