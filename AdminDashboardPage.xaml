<Page x:Class="MusicSchoolWpf.AdminDashboardPage"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminDashboardPage" Background="Black">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                <TextBlock Text="ניהול תוכן במערכת" Foreground="DarkRed" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <WrapPanel x:Name="wpItems" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Background="#111" BorderBrush="DarkRed" BorderThickness="2,0,0,0" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock Text="הוספת / עריכת שיר" Foreground="DarkRed" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="שם השיר:" Foreground="White" Margin="0,5"/>
                    <TextBox x:Name="txtSongName" Background="#222" Foreground="White" Height="30" VerticalContentAlignment="Center"/>

                    <TextBlock Text="אמן:" Foreground="White" Margin="0,10,0,5"/>
                    <ComboBox x:Name="cmbArtist" Background="#222" Foreground="Black" Height="30"/>

                    <TextBlock Text="סגנון (ג'אנר):" Foreground="White" Margin="0,10,0,5"/>
                    <ComboBox x:Name="cmbGenre" Background="#222" Foreground="Black" Height="30"/>

                    <TextBlock Text="שפה:" Foreground="White" Margin="0,10,0,5"/>
                    <ComboBox x:Name="cmbLanguage" Background="#222" Foreground="Black" Height="30"/>

                    <TextBlock Text="דרגת קושי:" Foreground="White" Margin="0,10,0,5"/>
                    <materialDesign:RatingBar x:Name="songRating" Value="3" Foreground="DarkRed"/>

                    <TextBlock Text="תמונת שיר:" Foreground="White" Margin="0,15,0,5"/>
                    <Button Content="בחר תמונה מהמחשב" Background="#333" Click="BtnUploadPic_Click"/>
                    <TextBlock x:Name="lblPicStatus" Text="לא נבחרה תמונה" Foreground="Gray" FontSize="11" Margin="0,2"/>

                    <TextBlock Text="מילים ואקורדים (הדבק כאן בפורמט חכם):" Foreground="White" Margin="0,15,0,5"/>
                    <TextBlock Text="דוגמה: פעם אחת[Am] הייתי צעיר[G]" Foreground="Gray" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLyricsAndChords" Background="#222" Foreground="White" Height="120" AcceptsReturn="True" TextWrapping="Wrap"/>

                    <Button Content="שמור שיר במערכת" Background="DarkRed" Height="40" Margin="0,25,0,0" Click="BtnSaveSong_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>