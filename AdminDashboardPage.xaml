<Page x:Class="MusicSchoolWpf.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AdminDashboardPage"
      Background="#080808">

    <Grid Background="#080808">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- כותרת -->
        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="ברוך הבא לממשק הניהול"
                           Foreground="#777"
                           FontSize="12"
                           FontWeight="Bold"/>

                <TextBlock FontSize="22"
                           FontWeight="Bold"
                           Foreground="White">
                    <Run Text="שלום, "/>
                    <Run x:Name="username"
                         Text="Admin"
                         Foreground="#CC2200"/>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="42"
                    Height="42"
                    CornerRadius="12"
                    Background="#111"
                    BorderBrush="#CC2200"
                    BorderThickness="1">
                <materialDesign:PackIcon Kind="ShieldAccount"
                                         Foreground="#CC2200"
                                         Width="23"
                                         Height="23"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- באנר -->
        <Border Grid.Row="1"
                Margin="18,0,18,18"
                CornerRadius="16"
                Background="#0D0D0D"
                BorderBrush="#1A1A1A"
                BorderThickness="1"
                Height="135">

            <Grid>
                <StackPanel Margin="24,22,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                    <TextBlock Text="ADMIN PANEL"
                               Foreground="#CC2200"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Margin="0,6,0,12"
                               FontSize="24"
                               FontWeight="Black">
                        <Run Text="ניהול "/>
                        <Run Text="גיטהורן" Foreground="#CC2200"/>
                    </TextBlock>

                    <TextBlock Text="כאן אפשר להוסיף שירים, לערוך מידע, לנהל אקורדים ולהשתמש בכלי המשתמש הרגילים."
                               Foreground="#999"
                               FontSize="12"
                               Width="520"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="פעולות"
                   Foreground="#888"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="18,0,18,10"/>

        <!-- כרטיסים -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <UniformGrid Rows="3"
                         Columns="2"
                         Margin="18,0,18,20">

                <!-- ניהול שירים -->
                <Border Margin="0,0,6,6"
                        MouseLeftButtonDown="ManageSongs_Click"
                        Cursor="Hand"
                        CornerRadius="12"
                        Background="#141414"
                        BorderBrush="#CC2200"
                        BorderThickness="1.3">
                    <StackPanel Margin="18">
                        <materialDesign:PackIcon Kind="PlaylistMusic"
                                                 Foreground="#CC2200"
                                                 Width="28"
                                                 Height="28"/>
                        <TextBlock Text="הוספת / עריכת שירים"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="ניהול שירים, תמונות, מילים ואקורדים"
                                   Foreground="#777"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- אקורדים -->
                <Border Margin="6,0,0,6"
                        MouseLeftButtonDown="ChordClick"
                        Cursor="Hand"
                        CornerRadius="12"
                        Background="#141414"
                        BorderBrush="DarkRed"
                        BorderThickness="1">
                    <StackPanel Margin="18">
                        <materialDesign:PackIcon Kind="GuitarAcoustic"
                                                 Foreground="#CC2200"
                                                 Width="28"
                                                 Height="28"/>
                        <TextBlock Text="ספריית אקורדים"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="צפייה וחיפוש אקורדים"
                                   Foreground="#777"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- שירים רגילים -->
                <Border Margin="0,6,6,6"
                        MouseLeftButtonDown="SongsClick"
                        Cursor="Hand"
                        CornerRadius="12"
                        Background="#141414"
                        BorderBrush="DarkRed"
                        BorderThickness="1">
                    <StackPanel Margin="18">
                        <materialDesign:PackIcon Kind="MusicNote"
                                                 Foreground="#CC2200"
                                                 Width="28"
                                                 Height="28"/>
                        <TextBlock Text="תצוגת משתמש - שירים"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="בדיקה איך המשתמש רואה את השירים"
                                   Foreground="#777"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- טיונר -->
                <Border Margin="6,6,0,6"
                        MouseLeftButtonDown="TunerClick"
                        Cursor="Hand"
                        CornerRadius="12"
                        Background="#141414"
                        BorderBrush="DarkRed"
                        BorderThickness="1">
                    <StackPanel Margin="18">
                        <materialDesign:PackIcon Kind="Tune"
                                                 Foreground="#CC2200"
                                                 Width="28"
                                                 Height="28"/>
                        <TextBlock Text="טיונר"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="כוונון גיטרה"
                                   Foreground="#777"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- מטרונום -->
                <Border Margin="0,6,6,0"
                        MouseLeftButtonDown="MetroClick"
                        Cursor="Hand"
                        CornerRadius="12"
                        Background="#141414"
                        BorderBrush="DarkRed"
                        BorderThickness="1">
                    <StackPanel Margin="18">
                        <materialDesign:PackIcon Kind="Metronome"
                                                 Foreground="#CC2200"
                                                 Width="28"
                                                 Height="28"/>
                        <TextBlock Text="מטרונום"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="תרגול קצב"
                                   Foreground="#777"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- יציאה -->
                <Border Margin="6,6,0,0"
                        MouseLeftButtonDown="LogoutClick"
                        Cursor="Hand"
                        CornerRadius="12"
                        Background="#141414"
                        BorderBrush="#333"
                        BorderThickness="1">
                    <StackPanel Margin="18">
                        <materialDesign:PackIcon Kind="Logout"
                                                 Foreground="#888"
                                                 Width="28"
                                                 Height="28"/>
                        <TextBlock Text="יציאה"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,12,0,4"/>
                        <TextBlock Text="חזרה למסך ההתחברות"
                                   Foreground="#777"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </ScrollViewer>
    </Grid>
</Page>