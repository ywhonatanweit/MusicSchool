<Page x:Class="MusicSchoolWpf.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MusicSchoolWpf"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage"
      Background="#0D0D0D">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Grid.Column="1" x:Name="loginpannel" Visibility="Visible">
            <StackPanel>
                <TextBox x:Name="loginusername"
                         Width="220"
                         Margin="0 0 0 20"
                         VerticalContentAlignment="Bottom"
                         Foreground="#F5F5F5"
                         materialDesign:HintAssist.Hint="Username"
                         materialDesign:HintAssist.HintOpacity="0.6"
                         materialDesign:HintAssist.Foreground="#CC2200"
                         materialDesign:HintAssist.HelperText="Enter your username"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </StackPanel>
            <StackPanel>
                <PasswordBox x:Name="loginpassword"
                             Width="220"
                             Margin="0 0 0 20"
                             VerticalContentAlignment="Bottom"
                             Foreground="#F5F5F5"
                             materialDesign:HintAssist.HelperText="Not bound password"
                             materialDesign:HintAssist.Hint="Password"
                             materialDesign:HintAssist.HintOpacity="0.6"
                             materialDesign:HintAssist.Foreground="#CC2200"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" />
            </StackPanel>
            <Button x:Name="login"
                    Background="#CC2200"
                    Foreground="#F5F5F5"
                    Content="LOG IN"
                    Width="220"
                    RenderTransformOrigin="0.522,1.432"
                    Margin="0 0 0 8"
                    Click="Login"/>
            <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA">
                <Run Text="Don't have an account already? " />
                <Hyperlink Foreground="#CC2200"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Click="SwitchToSignup">
                    <Run Text="Sign up" />
                </Hyperlink>
            </TextBlock>
            <Button x:Name="admin" Content="admin entry" Background="Red" Foreground="White" Click="Admin"/>
        </StackPanel>

        <StackPanel x:Name="signuppannel" Grid.Column="1" Grid.Row="1"
                    Visibility="Collapsed" VerticalAlignment="Center">
            <TextBox x:Name="signupusername"
                     Width="220"
                     Margin="0 0 0 20"
                     VerticalContentAlignment="Bottom"
                     Foreground="#F5F5F5"
                     materialDesign:HintAssist.Hint="Username"
                     materialDesign:HintAssist.HintOpacity="0.6"
                     materialDesign:HintAssist.Foreground="#CC2200"
                     materialDesign:HintAssist.HelperText="Enter your username"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <PasswordBox x:Name="signuppassword"
                         Width="220"
                         Margin="0 0 0 20"
                         VerticalContentAlignment="Bottom"
                         Foreground="#F5F5F5"
                         materialDesign:HintAssist.HelperText="Not bound password"
                         materialDesign:HintAssist.Hint="Password"
                         materialDesign:HintAssist.HintOpacity="0.6"
                         materialDesign:HintAssist.Foreground="#CC2200"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" />
            <Button x:Name="signup"
                    Background="#CC2200"
                    Foreground="#F5F5F5"
                    Content="SIGN UP"
                    Width="220"
                    Margin="0 0 0 8"
                    Click="newsignup" />
            <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA">
                <Run Text="already registered? " />
                <Hyperlink Foreground="#CC2200"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Click="SwitchTologin">
                    <Run Text="log in" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel x:Name="adminpannel" Grid.Column="1" Grid.Row="1"
             Visibility="Collapsed" VerticalAlignment="Center">
            <TextBox x:Name="adminusername"
              Width="220"
              Margin="0 0 0 20"
              VerticalContentAlignment="Bottom"
              Foreground="#F5F5F5"
              materialDesign:HintAssist.Hint="Username"
              materialDesign:HintAssist.HintOpacity="0.6"
              materialDesign:HintAssist.Foreground="#CC2200"
              materialDesign:HintAssist.HelperText="Enter your username"
              materialDesign:TextFieldAssist.HasClearButton="True"
              Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <PasswordBox x:Name="adminpassword"
                  Width="220"
                  Margin="0 0 0 20"
                  VerticalContentAlignment="Bottom"
                  Foreground="#F5F5F5"
                  materialDesign:HintAssist.HelperText="Not bound password"
                  materialDesign:HintAssist.Hint="Password"
                  materialDesign:HintAssist.HintOpacity="0.6"
                  materialDesign:HintAssist.Foreground="#CC2200"
                  materialDesign:TextFieldAssist.HasClearButton="True"
                  Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" />
            <Button x:Name="adminentry"
             Background="#CC2200"
             Foreground="#F5F5F5"
             Content="ADMIN ENTERY"
             Width="220"
             Margin="0 0 0 8"
             Click="adminsignupclick" />
            <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA">
         <Run Text="not an admin? " />
         <Hyperlink Foreground="#CC2200"
                    TextDecorations="Underline"
                    Cursor="Hand"
                    Click="SwitchTologin">
             <Run Text="log in" />
         </Hyperlink>
            </TextBlock>
        </StackPanel>
        <Image Grid.Column="1" Margin="18,0,18,323" Source="/IMAGES/logo.png" Stretch="Fill"/>
    </Grid>
</Page>