
    <UserControl x:Class="MusicSchoolWpf.SongUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicSchoolWpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="Black">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- כותרת ותמונה -->
            <RowDefinition Height="Auto"/>
            <!-- שורת אייקונים ונתונים -->
            <RowDefinition Height="*"/>
            <!-- אזור המילים -->
        </Grid.RowDefinitions>

        <!-- חלק עליון: תמונה ושם השיר -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Name="namebox" Text="שם השיר" FontSize="60" FontWeight="Bold" Foreground="DarkRed">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <Border Grid.Column="1" Width="180" Height="180" CornerRadius="20" BorderBrush="DarkRed" BorderThickness="2" VerticalAlignment="Top">
                <Border.Clip>
                    <RectangleGeometry RadiusX="20" RadiusY="20" Rect="0,0,180,180"/>
                </Border.Clip>
                <!--<Image x:Name="imgSong" Stretch="UniformToFill" Source="pack://application:,,,/Resources/placeholder.jpg"/>-->
            </Border>
        </Grid>

        <!-- שורת נתונים מעוגלת עם אייקונים -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <!-- אמן -->
            <Border Background="#1A1A1A" CornerRadius="15" Padding="12,5" Margin="0,0,10,0" BorderBrush="#333" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountMusic" Foreground="DarkRed" VerticalAlignment="Center" Width="20" Height="20"/>
                    <TextBlock x:Name="artistbox" Text="אמן" Foreground="White" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- סגנון -->
            <Border Background="#1A1A1A" CornerRadius="15" Padding="12,5" Margin="0,0,10,0" BorderBrush="#333" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MusicNote" Foreground="DarkRed" VerticalAlignment="Center" Width="20" Height="20"/>
                    <TextBlock x:Name="genrebox" Text="סגנון" Foreground="White" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- שפה -->
            <Border Background="#1A1A1A" CornerRadius="15" Padding="12,5" Margin="0,0,10,0" BorderBrush="#333" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Translate" Foreground="DarkRed" VerticalAlignment="Center" Width="20" Height="20"/>
                    <TextBlock x:Name="lanbox" Text="שפה" Foreground="White" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- דרגת קושי (כוכבים) -->
            <Border Background="#1A1A1A" CornerRadius="15" Padding="12,5" BorderBrush="#333" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Seal" Foreground="DarkRed" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,5,0"/>
                    <materialDesign:RatingBar x:Name="diffRating" IsReadOnly="True" Value="3" Foreground="DarkRed" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- אזור מילים ואקורדים -->
        <Border Grid.Row="2" Background="#121212" CornerRadius="20" Margin="0,20,0,0" BorderBrush="#222" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <WrapPanel x:Name="songData" HorizontalAlignment="Right" FlowDirection="RightToLeft" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
